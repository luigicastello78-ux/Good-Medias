---
layout: layouts/base.njk
permalink: /blog/
title: Blog | Insights on Web Design, SEO & GEO | Good Medias
description: Practical guides on web design, web development, SEO and getting your business recommended by AI assistants like ChatGPT, Perplexity and Google AI Overviews.
---
    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Our Blog</span>
          <h2>Insights, Ideas &amp; Search Trends</h2>
          <p>Practical guides on web design, SEO and getting your business recommended by AI.</p>
        </div>

        <div class="blog-grid">
          {%- for post in collections.posts | reverse %}
          <article class="post">
            <a href="{{ post.url }}" class="post-img"><img src="{{ post.data.image }}" alt="{{ post.data.imageAlt }}" loading="lazy"><span class="tag">{{ post.data.tag }}</span></a>
            <div class="post-meta"><span><svg><use href="#i-cal"/></svg>{{ post.data.date | readableDate }}</span><span><svg><use href="#i-clock"/></svg>{{ post.data.readingTime }}</span></div>
            <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
            <a href="{{ post.url }}" class="read">Read Article <svg><use href="#i-arrow-r"/></svg></a>
          </article>
          {%- endfor %}
        </div>
      </div>
    </section>
